# Copy this file to config.toml and fill in your own values. The real config.toml is never committed.
# Run the program from the project root so it finds ./config.toml (or pass --config <path>).
# Priority: command line (--openai_model gpt-4o) > this file > environment variable (OPENAI_MODEL).
# An empty value means "not set". Use config.ini.example if you prefer INI syntax.

# Discord bot token (create a bot in the Discord developer portal).
discord_token = ""

# Which service to talk to: "openai" (the default) or "anthropic".
# llm_provider = "openai"

# Prompt caching: "on" (the default) or "off". The start of a request that stays the same can be kept by the service
# and read instead of counted again, at a lower price (Anthropic charges a little more the first time).
# prompt_cache = "on"

# How much the model thinks before it answers: "off" (the default), "low", "medium" or "high".
# llm_reasoning = "off"

# With --chat --tools: the most Steps (model calls) one question may take, and how long the whole
# answer may take in milliseconds (0: no limit).
# agent_max_steps = 10
# agent_turn_timeout_ms = 300000
# How long one tool call may take in milliseconds (0: no limit; a tool may have a limit of its own), and how
# many bytes of a tool's result are kept (longer results are cut, and the model is told).
# tool_timeout_ms = 30000
# tool_result_max_bytes = 16384
# With --chat --tools: the directory with the Skills (one subdirectory with a SKILL.md for each).
# skills_dir = "skills"
# How many tokens one request may take at most (an estimate). 0: what the window of the model leaves.
# context_budget_tokens = 0

# OpenAI, or any OpenAI-compatible server.
# Which of OpenAI's two request formats to use: "chat" (Chat Completions, the default) or "responses".
# openai_api = "chat"
# The model name sent to the service.
openai_model = ""
openai_api_key = ""
# Change this to use an OpenAI-compatible server (default: https://api.openai.com/v1).
# openai_base_url = "https://api.openai.com/v1"

# Anthropic.
anthropic_model = ""
anthropic_api_key = ""
# anthropic_base_url = "https://api.anthropic.com"

# Folder that holds the image-generation model files (default: models).
# model_dir = "models"
